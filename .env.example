# Copy this file to .env and fill in your values. .env is gitignored.
# Real environment variables always win over .env, so a container still
# starts from env alone (the brief's requirement) with no .env present.

# --- required for a real evaluation ---

# Base URL of the Catalog API. The bundled mock serves fixtures/catalog.json.
CATALOG_BASE=http://127.0.0.1:9001

# Your Anthropic key. LLM_API_KEY is also accepted.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- optional ---

# Model id. Any current Claude model, or whatever a local server has loaded.
LLM_MODEL=claude-sonnet-5

# Provider behind the LLM seam.
LLM_PROVIDER=anthropic

# Point the Anthropic-compatible client at a different server, e.g. LM Studio
# on http://127.0.0.1:1234. When set, the API key becomes optional.
# LLM_BASE_URL=

# Catalog fetch timeout, seconds.
CATALOG_TIMEOUT_S=5

# Cap on parallel cluster calls.
LLM_MAX_CONCURRENCY=4
